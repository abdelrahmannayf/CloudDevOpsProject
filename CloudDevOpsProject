pipeline {
    agent any

    environment {
        IMAGE_NAME = "abdelrahmannayf/finalproject"
    }

    stages {

        stage('Build Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
            }
        }

        stage('Push Image') {
            steps {
                sh 'docker push $IMAGE_NAME'
            }
        }

        stage('Delete Local Image') {
            steps {
                sh 'docker rmi $IMAGE_NAME'
            }
        }
    }
}
